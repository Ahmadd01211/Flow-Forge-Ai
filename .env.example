POSTGRES_PASSWORD=generate-a-local-password
APP_DB_PASSWORD=generate-a-different-local-password
SESSION_SIGNING_KEY=generate-at-least-32-random-bytes
PUBLIC_ORIGIN=http://localhost:8080
# Development mail is captured at http://localhost:8025. Configure SMTP for public delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
MAIL_FROM=FlowForge <no-reply@flowforge.local>
# Operator-reviewed MCP servers only. Example shape:
# MCP_CATALOG_JSON=[{"id":"docs","name":"Docs","url":"https://mcp.example.com/mcp","allowed_tools":["search"],"read_only_tools":["search"]}]
